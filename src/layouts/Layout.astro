---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Kater',
  description = 'Linux-Adressbuch mit vollständiger vCard 4.0-Unterstützung. Lokal, offline, Open Source.',
} = Astro.props

const pageTitle = title === 'Kater'
  ? 'Kater – Linux-Adressbuch'
  : `${title} – Kater`

const canonicalUrl = Astro.url.href
---
<!doctype html>
<html lang="de">
  <head>
    <!-- Anti-Flash: Theme vor erstem Render setzen. sessionStorage merkt den manuellen
         Toggle über Seitenwechsel hinweg, aber ein Reload derselben Seite verwirft ihn
         wieder und folgt der aktuellen Browser-Einstellung (Navigation Timing API). -->
    <script is:inline>
      ;(function(){
        var navEntries = performance.getEntriesByType && performance.getEntriesByType('navigation');
        var isReload = navEntries && navEntries.length && navEntries[0].type === 'reload';
        if (isReload) { try { sessionStorage.removeItem('theme'); } catch (e) {} }
        var t = isReload ? null : sessionStorage.getItem('theme');
        var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })()
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/kater_image.jpg', Astro.site).toString()} />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content="Kater" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/kater_image.jpg', Astro.site).toString()} />

    <meta name="theme-color" content="#4A90D9" />
    <link rel="icon" type="image/svg+xml" href="/kater-logo.svg" />
    <link rel="apple-touch-icon" href="/kater-logo.png" />
  </head>
  <body class="bg-white">

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-100">
      <div class="max-w-5xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 font-extrabold text-xl tracking-tight text-slate-900">
          <img src="/kater-logo.svg" alt="" class="w-8 h-8" />
          Kater
        </a>
        <nav class="flex items-center gap-5 text-sm font-medium text-slate-600">
          <a href="/" class="hover:text-[#4A90D9] transition-colors">Startseite</a>
          <a href="/changelog" class="hover:text-[#4A90D9] transition-colors">Changelog</a>
          <a
            href="https://github.com/nicolettas-muggelbude/Kater"
            target="_blank"
            rel="noopener"
            class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-slate-200 hover:border-slate-300 hover:bg-slate-50 transition-colors"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>

          <!-- Theme-Toggle ☀ [●] ☾ -->
          <div class="flex items-center gap-1.5 border-l border-slate-200 pl-4">
            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0Zm11.394-5.834a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75Zm-3.916 6.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-2.25A.75.75 0 0 1 12 18Zm-6.894-1.916a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.59-1.591ZM6 12a.75.75 0 0 1-.75.75H3a.75.75 0 0 1 0-1.5h2.25A.75.75 0 0 1 6 12Zm.166-6.166a.75.75 0 0 0 0 1.06l1.591 1.591a.75.75 0 1 0 1.06-1.06L7.227 5.834a.75.75 0 0 0-1.06 0Z"/>
            </svg>
            <button
              id="theme-toggle"
              role="switch"
              aria-checked="false"
              aria-label="Dark Mode umschalten"
              class="relative w-9 h-5 rounded-full transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-[#4A90D9] focus:ring-offset-1"
              style="background-color:#cbd5e1"
            >
              <span
                id="toggle-thumb"
                class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white shadow-sm transition-transform duration-200"
              ></span>
            </button>
            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 0 1 .162.819A8.97 8.97 0 0 0 9 6a9 9 0 0 0 9 9 8.97 8.97 0 0 0 3.463-.69.75.75 0 0 1 .981.98 10.503 10.503 0 0 1-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 0 1 .818.162Z" clip-rule="evenodd"/>
            </svg>
          </div>
        </nav>
      </div>
    </header>

    <!-- Inhalt -->
    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 mt-24">
      <div class="max-w-5xl mx-auto px-6 py-12">
        <div class="flex flex-col md:flex-row justify-between items-start gap-8">
          <div>
            <div class="flex items-center gap-2 font-extrabold text-xl tracking-tight mb-2 text-white">
              <img src="/kater-logo.svg" alt="" class="w-8 h-8" />
              Kater
            </div>
            <p class="text-sm max-w-xs">Linux-Adressbuch mit vollständiger vCard 4.0-Unterstützung. Open Source (GPLv3).</p>
          </div>
          <div class="flex flex-wrap gap-8 text-sm">
            <div class="space-y-2">
              <p class="text-white font-medium">Projekt</p>
              <ul class="space-y-1">
                <li><a href="/" class="hover:text-white transition-colors">Startseite</a></li>
                <li><a href="/changelog" class="hover:text-white transition-colors">Changelog</a></li>
              </ul>
            </div>
            <div class="space-y-2">
              <p class="text-white font-medium">Muggelbude</p>
              <ul class="space-y-1">
                <li><a href="https://muggelbude.it" target="_blank" rel="noopener" class="hover:text-white transition-colors">muggelbude.it</a></li>
              </ul>
            </div>
            <div class="space-y-2">
              <p class="text-white font-medium">GitHub</p>
              <ul class="space-y-1">
                <li><a href="https://github.com/nicolettas-muggelbude/Kater" target="_blank" rel="noopener" class="hover:text-white transition-colors">Repository</a></li>
                <li><a href="https://github.com/nicolettas-muggelbude/Kater/issues" target="_blank" rel="noopener" class="hover:text-white transition-colors">Bugs & Ideen</a></li>
              </ul>
            </div>
            <div class="space-y-2">
              <p class="text-white font-medium">Rechtliches</p>
              <ul class="space-y-1">
                <li><a href="/impressum" class="hover:text-white transition-colors">Impressum</a></li>
                <li><a href="/datenschutz" class="hover:text-white transition-colors">Datenschutz</a></li>
              </ul>
            </div>
          </div>
        </div>
        <div class="border-t border-slate-800 mt-8 pt-8 text-xs text-slate-500 text-center">
          © {new Date().getFullYear()} Kater – GPLv3
        </div>
      </div>
    </footer>

    <script>
      // Alle externen Links in neuem Tab öffnen
      document.querySelectorAll('a[href^="http"]').forEach(a => {
        if (!a.hostname || a.hostname !== location.hostname) {
          a.setAttribute('target', '_blank')
          a.setAttribute('rel', 'noopener noreferrer')
        }
      })
    </script>

    <script is:inline>
      ;(function () {
        var root   = document.documentElement
        var toggle = document.getElementById('theme-toggle')
        var thumb  = document.getElementById('toggle-thumb')
        if (!toggle || !thumb) return

        function isDark() {
          return root.getAttribute('data-theme') === 'dark'
        }

        function apply(dark) {
          toggle.setAttribute('aria-checked', String(dark))
          toggle.style.backgroundColor = dark ? '#4A90D9' : '#cbd5e1'
          thumb.style.transform = dark ? 'translateX(16px)' : 'translateX(0)'
        }

        apply(isDark())

        toggle.addEventListener('click', function () {
          var dark = !isDark()
          root.setAttribute('data-theme', dark ? 'dark' : 'light')
          sessionStorage.setItem('theme', dark ? 'dark' : 'light')
          apply(dark)
        })

        // OS-Präferenz ändert sich → nur übernehmen wenn kein manuelles Override gesetzt
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          if (!sessionStorage.getItem('theme')) {
            root.setAttribute('data-theme', e.matches ? 'dark' : 'light')
            apply(e.matches)
          }
        })
      })()
    </script>
  </body>
</html>
