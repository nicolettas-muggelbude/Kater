---
import Layout from '../layouts/Layout.astro'

// Manuell gepflegt, analog zu CHANGELOG.md im master-Branch.
// Bei jedem neuen Release hier von Hand ergänzen.
const CHANGELOG = [
  {
    version: '1.3.0',
    datum: '2026-07-15',
    eintraege: [
      'Fritzbox-Telefonbuch-Export (XML), importierbar über die Fritzbox-Weboberfläche',
      'Speedport-Telefonbuch-Export (CSV) im Format der Telekom Speedport-Router',
      'Menü „Datei → Fritzbox" und „Datei → Speedport" mit Export für markierte oder alle Kontakte',
      'install.sh jetzt auch als eigenständiges Release-Artifact verfügbar',
    ],
  },
  {
    version: '1.2.4',
    datum: '2026-05-14',
    eintraege: [
      'Gruppen in der Gruppenverwaltung zusammenführen',
      'Gruppenverwaltung: Umbenennen und Löschen unter Extras',
      'Kontextmenü zum Zuweisen/Entfernen von Gruppen, neue Gruppe per +-Button anlegen',
    ],
  },
  {
    version: '1.2.3',
    datum: '2026-05-14',
    eintraege: [
      'Fix: Gruppenfilter bleibt nach Deaktivieren/Aktivieren an der richtigen Position',
    ],
  },
  {
    version: '1.2.2',
    datum: '2026-05-14',
    eintraege: [
      'Gruppenfilter in der Seitenleiste (Combobox, nur bei aktivierten Gruppen)',
    ],
  },
  {
    version: '1.2.1',
    datum: '2026-05-14',
    eintraege: [
      'Fix: Thunderbird-CSV-Parser unterstützt jetzt auch deutsche Spaltenköpfe',
    ],
  },
  {
    version: '1.2.0',
    datum: '2026-05-14',
    eintraege: [
      'Thunderbird-CSV-Import mit Kontakt-Picker und optionaler Gruppenverwaltung',
    ],
  },
  {
    version: '1.1.3',
    datum: '2026-04-27',
    eintraege: [
      'Warnung bei ungespeicherten Änderungen beim Kontaktwechsel',
      'Adress-Tab in drei separate Sub-Tabs aufgeteilt (Privat/Arbeit/Sonstige)',
      'Kontakte als vCard in die Zwischenablage kopieren (Strg+Umschalt+C)',
    ],
  },
  {
    version: '1.1.2',
    datum: '2026-04-27',
    eintraege: [
      'Fix: FUSE 2/3-Konflikt für Ubuntu 26.04 behoben',
    ],
  },
  {
    version: '1.1.1',
    datum: '2026-04-12',
    eintraege: [
      'Thunderbird-Export und Mehrfachauswahl',
      'Fix: Installationspfad korrigiert (Kater.AppImage statt Kater-x86_64.AppImage)',
    ],
  },
  {
    version: '1.1.0',
    datum: '2026-03-31',
    eintraege: [
      'In-App-Update ersetzt das AppImage direkt',
    ],
  },
  {
    version: '1.0.1',
    datum: '2026-03-31',
    eintraege: [
      'Fix: Entf-Taste in Eingabefeldern und deutsches Datumsformat',
      'Screenshot der App im README ergänzt',
    ],
  },
  {
    version: '1.0.0',
    datum: '2026-03-29',
    eintraege: [
      'Erste Veröffentlichung: Kontaktverwaltung, vCard-Import/Export, SQLite-Datenbank',
      'AppImage-Build, Auto-Updater und GitHub-Actions-Release-Workflow',
      'install.sh für Desktop-Integration unter Linux',
    ],
  },
]
---

<Layout title="Changelog" description="Versionshistorie von Kater – alle Neuerungen und Verbesserungen.">

  <div class="max-w-3xl mx-auto px-6 py-16">

    <div class="mb-12">
      <h1 class="text-4xl font-extrabold text-slate-900 mb-3">Changelog</h1>
      <p class="text-slate-500">
        Neueste Version zuerst. Ältere Versionen siehe <a href="https://github.com/nicolettas-muggelbude/Kater/releases" target="_blank" rel="noopener" class="text-[#4A90D9] hover:underline">GitHub Releases ↗</a>.
      </p>
    </div>

    <div class="space-y-12">
      {CHANGELOG.map(v => (
        <section>
          <div class="flex items-baseline gap-3 mb-4">
            <h2 class="text-xl font-bold text-slate-900">{v.version}</h2>
            <span class="text-sm text-slate-400">{v.datum}</span>
          </div>
          <ul class="space-y-2 list-disc list-inside text-sm text-slate-600">
            {v.eintraege.map(e => <li>{e}</li>)}
          </ul>
        </section>
      ))}
    </div>

  </div>

</Layout>
